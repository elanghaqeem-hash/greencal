{
  "name": "greencal-crms-enterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:vercel": "node --test tests/vercel-runtime.test.mjs tests/vercel-bank-schema.test.mjs tests/vercel-cloudflare-cutover.test.mjs tests/vercel-migration-inventory.test.mjs tests/vercel-browser-backup-migration.test.mjs",
    "test:postgres": "node --test tests/vercel-postgres-integration.test.mjs",
    "test:onprem": "node --test tests/onprem-precision.test.mjs tests/onprem-iam.test.mjs tests/onprem-audit-cycle.test.mjs tests/onprem-deployment.test.mjs",
    "test:onprem-postgres": "node --test tests/onprem-postgres.test.mjs",
    "registry:validate": "node scripts/registry/validate-crms26.mjs",
    "migrate:onprem": "node scripts/onprem/apply-migrations.mjs",
    "migrate:onprem:plan": "node scripts/onprem/apply-migrations.mjs --dry-run",
    "release:verify-onprem": "node scripts/release/verify-onprem.mjs",
    "release:bundle": "node scripts/release/build-offline-bundle.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
