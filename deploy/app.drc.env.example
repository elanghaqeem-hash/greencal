# Salin menjadi deploy/app.drc.env pada host DRC.
#
# Menunjuk ke standby yang read-only. Aplikasi DRC berjalan dengan
# GREENCAL_ROLE=standby sehingga seluruh rute tulis menolak permintaan sampai
# promosi dinyatakan prosedur failover.
GREENCAL_ONPREM_PG_URL=postgresql://crms_readonly@db-standby:5432/crms_onprem?sslmode=verify-full&sslrootcert=/run/secrets/db_ca_cert&passfile=/run/secrets/db_readonly_passfile
GREENCAL_OBJECT_BUCKET=crms-evidence
GREENCAL_AUDIT_RETENTION_DAYS=3650
