# Salin menjadi deploy/app.env pada host DC, lalu isi nilainya. Berkas app.env
# TIDAK pernah masuk repositori; .gitignore menolaknya.
#
# Kata sandi basis data tidak ditulis di sini dalam teks jelas pada instalasi
# produksi: pakai passfile yang dipasang lewat Docker secret dan rujuk dengan
# parameter passfile pada connection string.

# sslmode=verify-full wajib: verify-ca saja tidak memeriksa nama host, sehingga
# tidak melindungi dari pengalihan ke basis data lain di intranet yang sama.
GREENCAL_ONPREM_PG_URL=postgresql://crms_app@db:5432/crms_onprem?sslmode=verify-full&sslrootcert=/run/secrets/db_ca_cert&passfile=/run/secrets/db_app_passfile

# Penyimpanan objek bukti dan ekspor laporan.
GREENCAL_OBJECT_BUCKET=crms-evidence
GREENCAL_OBJECT_REGION=id-dc-1

# Penyedia identitas bank (SAML atau OIDC). Metadata dibaca dari berkas lokal,
# bukan diunduh saat runtime, karena egress ditolak.
GREENCAL_OIDC_ISSUER=https://sso.intranet.local/realms/bank
GREENCAL_OIDC_METADATA_FILE=/run/secrets/oidc_metadata.json
GREENCAL_OIDC_CLIENT_ID=greencal-crms

# Retensi log audit dalam hari. Nilai minimum ditentukan kebijakan bank dan
# ketentuan OJK; 3650 hari (10 tahun) adalah titik awal yang konservatif.
GREENCAL_AUDIT_RETENTION_DAYS=3650
