# Salin menjadi deploy/migrator.env pada host DC. Hanya dipakai layanan
# migrator, yang berjalan sekali lalu berhenti.
#
# Peran crms_migrator terpisah dari crms_app: aplikasi runtime tidak boleh
# memiliki hak mengubah skema.
GREENCAL_ONPREM_PG_URL=postgresql://crms_migrator@db:5432/crms_onprem?sslmode=verify-full&sslrootcert=/run/secrets/db_ca_cert&passfile=/run/secrets/db_migrator_passfile
