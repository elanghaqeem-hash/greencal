{
  "name": "greencal",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greencal-db",
      "database_id": "REPLACE_WITH_GREENCAL_D1_UUID"
    }
  ],
  "vars": {
    "AI_DEFAULT_MODEL": "gemini-2.5-flash"
  }
}