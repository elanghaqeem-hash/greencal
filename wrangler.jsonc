{
  "name": "greencal",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greencal-db",
      "database_id": "f9169067-32bc-425c-bef8-1cb86a4d5fcd"
    }
  ],
  "vars": {
    "AI_DEFAULT_MODEL": "gemini-2.5-flash"
  }
}