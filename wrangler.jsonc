{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greencal",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-18",
  "vars": {
    "GREENCAL_PUBLIC_AI_ENABLED": "true"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "AI_CONFIG",
      "id": "9656c959e89441fc9d99ab5334f079f7"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greencal-db",
      "database_id": "f9169067-32bc-425c-bef8-1cb86a4d5fcd"
    }
  ]
}
